{"id": "b7b53e9ce5eda05defa5fe7fdf5d7163", "document": "https://data.geopf.fr/annexes/gpu/documents/DU_19010/b7b53e9ce5eda05defa5fe7fdf5d7163/19010_reglement_20220922.pdf", "date": "2026-11-20", "zones": {"AU1": {"source": "ia", "citations": {"ces": {"value": 100, "status": "extrait", "article": "AU1-9", "page": 61, "citation": "Non réglementé.", "condition": "Non réglementé"}, "h": {"value": null, "status": "non_trouve", "article": "AU1-10", "page": 61, "citation": "La hauteur des constructions doit être compatible avec celle du site environnant afin de permettre une intégration et un raccordement harmonieux avec le tissu urbain existant", "condition": "La hauteur doit être compatible avec le site environnant. Pour les équipements d'intérêt collectif et services publics, 5m à l'égout ou 6m à l'acrotère."}, "recul": {"value": 0, "status": "extrait", "article": "AU1-6", "page": 60, "citation": "Les bâtiments peuvent être implantés à l’alignement ou à 5,00 m de l’alignement minimum.", "condition": "75m par rapport à la RD1120 (35m secteur Pigeonnier), 25m RD 1ère cat, 10m RD 2/3 cat, sinon 0m ou 5m."}, "ret": {"value": 3, "status": "extrait", "article": "AU1-7", "page": 60, "citation": "soit à une distance telle que les façades devront être écartées d’une distance au moins égale à la moitié de la hauteur du bâti avec un minimum de 3 mètres", "condition": "Soit sur limite, soit H/2 avec minimum 3m."}}, "zoneTrouvee": true, "remarque": "", "ces": 1, "h": null, "recul": 0, "ret": 3, "pt": null, "stat": null, "document": "https://data.geopf.fr/annexes/gpu/documents/DU_19010/b7b53e9ce5eda05defa5fe7fdf5d7163/19010_reglement_20220922.pdf"}, "AU2": {"source": "ia", "citations": {}, "zoneTrouvee": false, "remarque": "", "ces": null, "h": null, "recul": null, "ret": null, "pt": null, "stat": null, "document": "https://data.geopf.fr/annexes/gpu/documents/DU_19010/b7b53e9ce5eda05defa5fe7fdf5d7163/19010_reglement_20220922.pdf"}, "AU2t": {"source": "ia", "citations": {}, "zoneTrouv