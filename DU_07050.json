{"id": "054576f162249aac85bd0832ce6b811e", "document": "https://data.geopf.fr/annexes/gpu/documents/DU_07050/054576f162249aac85bd0832ce6b811e/07050_reglement_20230923.pdf", "date": "2026-11-18", "zones": {"1AUa": {"source": "ia", "citations": {}, "zoneTrouvee": false, "remarque": "", "ces": null, "h": null, "recul": null, "ret": null, "pt": null, "stat": null, "document": "https://data.geopf.fr/annexes/gpu/documents/DU_07050/054576f162249aac85bd0832ce6b811e/07050_reglement_20230923.pdf"}, "1AUi": {"source": "ia", "citations": {"ces": {"value": 60, "status": "extrait", "article": "Article 1AUi 9", "page": 54, "citation": "Le coefficient d’emprise au sol n’est pas réglementé pour les constructions et installations nécessaires aux services publics ou d’intérêt collectif. Dans les autres cas, il est fixé à 0,60.", "condition": "0,60 sauf pour les services publics ou d'intérêt collectif (non réglementé)"}, "h": {"value": 10, "status": "extrait", "article": "Article 1AUi 10", "page": 54, "citation": "Pour les bâtiments présentant des toitures à pans, la hauteur maximale est fixée à 10 mètres par rapport à la cote du terrain naturel", "condition": "10 mètres maximum pour les toitures à pans"}, "recul": {"value": 5, "status": "extrait", "article": "Article 1AUi 6", "page": 53, "citation": "Une façade gouttereau des bâtiments édifiés dans une bande de 35 m comptés à partir de l’axe de la R.D.104a. doit être implantée à 15 m de l’alignement de cette voie. Ailleurs dans la zone, les constructions doivent être implantées selon un recul minimum de 5 m", "condition": "15 m par rapport à l'alignement de la RD104a (bande de 35m) ou 5 m pour les autres voies"}, "ret": {"value": 3, "status": "extrait", "article": "Article 1AUi 7", "page": 54, "citation": "La distance comptée horizontalement de tout point de la construction au point le plus proche d'une limite séparative sur laquelle le bâtiment n’est pas implanté doit être au moins égale à 3 m.", "condition": "3 mètres minimum"}}, "z